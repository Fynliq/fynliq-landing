# Server-only Vercel settings. Never prefix secrets with VITE_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Production defaults to same-origin /api/analyze and /api/ask.
# Local Vite development uses demo sources unless URLs are provided.
# See docs/LIVE_ASK_SETUP.md for the signed document-review contract.
VITE_FYNLIQ_ANALYZE_URL=
VITE_FYNLIQ_ASK_URL=

# Search popularity remains clearly labeled sample data unless connected.
VITE_FYNLIQ_SEARCH_URL=

# Accounts stay disabled until migrations, provider setup and isolation tests pass.
VITE_ACCOUNTS_ENABLED=false
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
ACCOUNTS_ENABLED=false
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ACCOUNT_SESSION_SECRET=
