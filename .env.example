# Copy to .env.local and fill in to connect the backend.
#
# Each of the three is independent: connect one, two or all of them. Left
# unset, that part of the product runs on a local source that walks the same
# code path and says so on screen rather than passing itself off as real.

# The document reader — /beta
#
# Unset: the beta flow runs on the local stub. Every screen, stage and
# calculation is real, and the results page states on screen that the figures
# are demo ones rather than the student's.
#
# Set: the flow POSTs the uploaded files to this endpoint and renders whatever
# comes back, after validating it against docs/ANALYSIS_API.md.
VITE_FYNLIQ_ANALYZE_URL=

# Search analytics — /search
#
# Unset: the ranking runs on sample figures, and a line under it says so.
#
# Set: the page GETs real search demand here and POSTs each search to
# {url}/events. Validated against docs/SEARCH_ANALYTICS_API.md.
VITE_FYNLIQ_SEARCH_URL=

# The answer service — /ask
#
# Unset: answers are composed locally from the question library plus the
# student's own award, via the tested functions in src/core/ask.ts.
#
# Set: the page POSTs the question and the student's analysis here.
# Validated against docs/ASK_API.md.
VITE_FYNLIQ_ASK_URL=
