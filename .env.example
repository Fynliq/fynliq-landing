# Server-only Vercel settings. Never prefix secrets with VITE_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Production defaults to same-origin /api/analyze and /api/ask.
# Local Vite development uses demo sources unless URLs are provided.
# See docs/LIVE_ASK_SETUP.md for the signed document-review contract.
VITE_FYNLIQ_ANALYZE_URL=
VITE_FYNLIQ_ASK_URL=

# Search popularity remains clearly labeled sample data unless connected.
VITE_FYNLIQ_SEARCH_URL=

# Accounts stay disabled until migrations, provider setup and isolation tests pass.
VITE_ACCOUNTS_ENABLED=false
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
ACCOUNTS_ENABLED=false
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ACCOUNT_SESSION_SECRET=

# Public guest beta: server-only. Empty/false configuration fails closed.
BETA_ENABLED=false
BETA_ORIGIN=https://www.fynliq.com
BETA_RATE_SECRET=
BETA_ADMIN_USER_IDS=
BETA_MAX_QUESTIONS_PER_DAY=10000
ASK_USER_MAX_PER_DAY=50
ASK_USER_MAX_PER_MINUTE=8
OPENAI_MAX_OUTPUT_TOKENS=1200

# Log-in and sign-up (/login, /signup). Production uses same-origin /api/auth
# (Supabase accounts, httpOnly cookie sessions, sign-up and log-in tracking in
# /admin). Set this only to point the pages at a different account service.
# Left unset in local development, accounts live in this browser only.
VITE_FYNLIQ_AUTH_URL=

# FYNQ Beta Unlock ($1 one-time, Stripe Checkout). Server-only: never prefix
# any of these with VITE_. See docs/BILLING.md. Keep PAYWALL_ENABLED=false
# until the migration is applied and a Stripe TEST MODE run has passed.
PAYWALL_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# Live keys (sk_live_/rk_live_) are refused unless this is exactly true.
STRIPE_ALLOW_LIVE_MODE=false
# Accounts with accounts.created_at at or before this instant never pay.
FYNQ_BETA_GRANDFATHER_CUTOFF=2026-09-30T18:53:52.654622Z
# Comma-separated FYNQ account ids that bypass payment and are excluded from
# revenue/conversion (BETA_ADMIN_USER_IDS are excluded too).
FYNQ_BILLING_TEST_ACCOUNT_IDS=
# 32+ random characters. Encrypts the short-lived redacted aid lines kept
# while a phone visits Stripe in the same tab. Unset = phones must allow the
# checkout tab instead (desktop flow). Generate: openssl rand -base64 48
FYNQ_PENDING_ANALYSIS_KEY=
# Seconds the pending payload lives (60-1800, default 1800).
FYNQ_PENDING_ANALYSIS_TTL_SECONDS=1800
