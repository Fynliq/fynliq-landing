# Required server-side secret; generate with openssl rand -hex 32
CLOUD_GATEWAY_API_KEY=
CLOUD_MODEL_NAME=company-model
# Native Node server: localhost. Docker gateway: host.docker.internal for a trusted local model server.
CLOUD_UPSTREAM_URL=http://127.0.0.1:8000/v1/chat/completions
CLOUD_UPSTREAM_API_KEY=
CLOUD_BIND_HOST=127.0.0.1
CLOUD_PORT=8787
CLOUD_TIMEOUT_MS=30000
CLOUD_REQUESTS_PER_MINUTE=60
CLOUD_MAX_CONCURRENT=2
